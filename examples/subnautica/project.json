{
 "game": "Subnautica",
 "steam_appid": 264710,
 "engine": "unity-mono",
 "integration_branch": "deep-vr",
 "log_path": "~/.local/share/Steam/steamapps/common/Subnautica/BepInEx/LogOutput.log",
 "build": {
  "cmd": "export DOTNET_ROOT=~/.dotnet PATH=~/.dotnet:$PATH && cd SubmersedVR && dotnet build -nologo -v q",
  "output": "SubmersedVR/build",
  "stamp_to": "SubmersedVR/build/BepInEx/plugins/irisify/build.json"
 },
 "deploy": {
  "refuse_if_running": "pgrep -f '^[A-Z]:.*Subnautica\\.exe'"
 },
 "rig": {
  "rig_dir": "~/.local/share/Steam/steamapps/common/Subnautica/BepInEx/testrig",
  "start": "~/vr-rig/rig-launch.sh",
  "stop": "~/vr-rig/rig-stop.sh",
  "patch_line": "loaded and patches applied! \\((\\d+) patch classes\\)",
  "load": {
   "cmd": "load",
   "slot": "slot9000"
  },
  "saves": {
   "creative": {
    "cmd": "load",
    "slot": "slot9000"
   },
   "survival": {
    "cmd": "load",
    "slot": "slot9001"
   }
  }
 },
 "core": [
  {
   "files": [
    "VR/BodyFrame.cs",
    "VR/HolsterLayout.cs",
    "VR/VRFullBody.cs",
    "VR/HeightCalibration.cs"
   ],
   "tags": [
    "body",
    "holsters",
    "pda",
    "carry"
   ],
   "full_sets": true
  },
  {
   "files": [
    "Input/InputClaims.cs",
    "Input/GripRouting.cs",
    "Input/SteamVrGameInput.cs"
   ],
   "tags": [
    "input",
    "grab",
    "locomotion",
    "holsters",
    "containers"
   ],
   "full_sets": true
  },
  {
   "files": [
    "Settings.cs",
    "Settings*.cs",
    "SettingsMigration.cs"
   ],
   "tags": [
    "settings"
   ]
  },
  {
   "files": [
    "VR/MachinePanel.cs",
    "VR/ReadableUi.cs"
   ],
   "tags": [
    "ui",
    "machines",
    "containers"
   ]
  }
 ]
}
